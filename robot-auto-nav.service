[Unit]
Description=Robot Auto Relocalization And Navigation
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=jw
Group=jw

Environment=ROS_DOMAIN_ID=0
Environment=ROS_LOCALHOST_ONLY=0
Environment=NAV_HEADLESS=1

# 建议一直重试重定位
Environment=AUTO_NAV_ATTEMPTS=999999
Environment=AUTO_NAV_RETRY_DELAY=10

# 可选：指定固定任务；不写则自动找 task 目录第一个 txt
# Environment=AUTO_NAV_TASK=test
# Environment=AUTO_NAV_LOOP=1

# 使用 jw 用户登录目录找到 robot.env；实际工作空间和数据路径均由 robot.env 决定。
ExecStart=/bin/bash -lc 'source "$HOME/robot_rk3588_ws/src/robot.env" && exec "$ROBOT_WS/src/run_autostart_nav.sh"'

Restart=on-failure
RestartSec=15
TimeoutStopSec=45
KillMode=control-group

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

