<?xml version="1.0"?>
<package format="3">
  <name>dual_airy_fusion</name>
  <version>1.1.0</version>
  <description>Standalone dual Airy XYZIRT fusion with matrix extrinsics and startup time checking.</description>
  <maintainer email="jw@example.com">jw</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>yaml-cpp</depend>
  <depend>nlohmann-json-dev</depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>rmw_fastrtps_cpp</exec_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
