[Unit]
Description=UWB AOA robot serial node
After=network.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=jw
SupplementaryGroups=dialout
WorkingDirectory=/home/jw/uwb_ws/src/uwb_aoa_pkg
Environment="ROS_DISTRO=humble"
Environment="FASTRTPS_DEFAULT_PROFILES_FILE=/home/jw/uwb_ws/src/uwb_aoa_pkg/dds/fastdds.xml"
# Prefer ttyUSB0, then ttyUSB1; retry startup if neither device exists.
ExecStartPre=+/bin/bash -c 'for device in /dev/ttyUSB0 /dev/ttyUSB1; do if [[ -c "$$device" ]]; then /usr/bin/chgrp dialout "$$device" && /usr/bin/chmod 660 "$$device"; exit $$?; fi; done; echo "No UWB serial device found: /dev/ttyUSB0 or /dev/ttyUSB1" >&2; exit 1'
ExecStart=/bin/bash "/home/jw/uwb_ws/src/uwb_aoa_pkg/start_libAoa_robot.sh"
Restart=on-failure
RestartSec=5
KillMode=control-group
TimeoutStopSec=15

[Install]
