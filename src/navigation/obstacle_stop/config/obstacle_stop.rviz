Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /Obstacle Stop Areas1
        - /Occupied Height Columns (2.5D)1
        - /Occupied Cells1
        - /Occupied Cells1/Topic1
        - /Front Cropped Cloud (magenta inside, blue outside)1
        - /Front Cropped Cloud (magenta inside, blue outside)1/Topic1
        - /Rear Cropped Cloud (magenta inside, blue outside)1
        - /Rear Cropped Cloud (magenta inside, blue outside)1/Topic1
      Splitter Ratio: 0.5
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.4
      Cell Size: 0.1
      Class: rviz_default_plugins/Grid
      Color: 100; 100; 100
      Enabled: true
      Line Style:
        Line Width: 0.01
        Value: Lines
      Name: Grid (0.1 m)
      Plane: XY
      Plane Cell Count: 40
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz_default_plugins/Axes
      Enabled: true
      Length: 0.5
      Name: Base Axes
      Radius: 0.015
      Reference Frame: base_link
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /obstacle_stop/detection_marker
      Name: Obstacle Stop Areas
      Namespaces:
        obstacle_stop_counts: true
        obstacle_stop_front: true
        obstacle_stop_rear: true
        obstacle_stop_left: true
        obstacle_stop_right: true
      Queue Size: 10
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Occupied Height Columns (2.5D)
      Namespaces:
        height_cells: true
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /obstacle_stop/occupied_columns
      Value: true
    - Alpha: 1
      Class: rviz_default_plugins/PointCloud2
      Color: 255; 255; 0
      Color Transformer: FlatColor
      Decay Time: 0.2
      Enabled: false
      Name: Occupied Cells
      Position Transformer: XYZ
      Selectable: true
      Size (Pixels): 5
      Size (m): 0.04
      Style: Flat Squares
      Topic:
        Depth: 5
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /obstacle_stop/occupied_cells
      Use Fixed Frame: true
      Value: false
    - Alpha: 1
      Class: rviz_default_plugins/PointCloud2
      Color: 100; 180; 255
      Color Transformer: RGB8
      Decay Time: 0
      Enabled: false
      Name: Front Cropped Cloud (magenta inside, blue outside)
      Position Transformer: XYZ
      Selectable: true
      Size (Pixels): 4
      Size (m): 0.025
      Style: Spheres
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /obstacle_stop/front_cloud_base
      Use Fixed Frame: true
      Value: false
    - Alpha: 1
      Class: rviz_default_plugins/PointCloud2
      Color: 200; 140; 255
      Color Transformer: RGB8
      Decay Time: 0
      Enabled: false
      Name: Rear Cropped Cloud (magenta inside, blue outside)
      Position Transformer: XYZ
      Selectable: true
      Size (Pixels): 4
      Size (m): 0.025
      Style: Spheres
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /obstacle_stop/rear_cloud_base
      Use Fixed Frame: true
      Value: false
    - Alpha: 1
      Class: rviz_default_plugins/PointCloud2
      Color: 255; 210; 80
      Color Transformer: FlatColor
      Decay Time: 0
      Enabled: true
      Name: Front Full Cloud (base_link)
      Position Transformer: XYZ
      Selectable: true
      Size (Pixels): 2
      Size (m): 0.012
      Style: Points
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /obstacle_stop/front_cloud_base_unfiltered
      Use Fixed Frame: true
      Value: true
    - Alpha: 1
      Class: rviz_default_plugins/PointCloud2
      Color: 80; 220; 255
      Color Transformer: FlatColor
      Decay Time: 0
      Enabled: true
      Name: Rear Full Cloud (base_link)
      Position Transformer: XYZ
      Selectable: true
      Size (Pixels): 2
      Size (m): 0.012
      Style: Points
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /obstacle_stop/rear_cloud_base_unfiltered
      Use Fixed Frame: true
      Value: true
  Enabled: true
  Global Options:
    Background Color: 35; 35; 35
    Fixed Frame: base_link
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 4
      Focal Point:
        X: 0
        Y: 0
        Z: 0.8
      Name: Current View
      Near Clip Distance: 0.01
      Pitch: 0.65
      Target Frame: <Fixed Frame>
      Value: Orbit (rviz_default_plugins)
      Yaw: 0.78
    Saved: ~
Window Geometry:
  Height: 900
  Hide Left Dock: false
  Hide Right Dock: false
  Width: 1200
