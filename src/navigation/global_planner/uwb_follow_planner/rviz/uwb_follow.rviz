Panels:
  - Class: rviz_common/Displays
    Help Height: 78
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /Robot State1
        - /UWB Follow1
        - /Local Avoidance1
      Splitter Ratio: 0.5
    Tree Height: 780
  - Class: rviz_common/Selection
    Name: Selection
  - Class: rviz_common/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Cell Size: 1
      Class: rviz_default_plugins/Grid
      Color: 120; 120; 120
      Enabled: true
      Line Style:
        Line Width: 0.03
        Value: Lines
      Name: Grid
      Plane: XY
      Plane Cell Count: 30
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz_common/Group
      Displays:
        - Angle Tolerance: 0.05
          Class: rviz_default_plugins/Odometry
          Covariance:
            Orientation:
              Alpha: 0.15
              Color: 255; 255; 127
              Color Style: Unique
              Frame: Local
              Offset: 1
              Scale: 1
              Value: false
            Position:
              Alpha: 0.15
              Color: 204; 51; 204
              Scale: 1
              Value: false
            Value: false
          Enabled: true
          Keep: 1
          Name: Robot Pose (FAST-LIO)
          Position Tolerance: 0.05
          Shape:
            Alpha: 1
            Axes Length: 0.8
            Axes Radius: 0.08
            Color: 255; 80; 30
            Head Length: 0.3
            Head Radius: 0.12
            Shaft Length: 0.7
            Shaft Radius: 0.06
            Value: Arrow
          Topic:
            Depth: 5
            Durability Policy: Volatile
            Filter size: 10
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /Odometry
          Value: true
        - Class: rviz_default_plugins/TF
          Enabled: false
          Frame Timeout: 15
          Frames:
            All Enabled: true
          Marker Scale: 0.6
          Name: TF
          Show Arrows: true
          Show Axes: true
          Show Names: false
          Update Interval: 0
          Value: false
      Enabled: true
      Name: Robot State
    - Class: rviz_common/Group
      Displays:
        - Alpha: 1
          Axes Length: 0.5
          Axes Radius: 0.05
          Class: rviz_default_plugins/Pose
          Color: 255; 40; 40
          Enabled: true
          Head Length: 0.25
          Head Radius: 0.12
          Name: UWB Person
          Shaft Length: 0.5
          Shaft Radius: 0.07
          Shape: Arrow
          Topic:
            Depth: 10
            Durability Policy: Volatile
            Filter size: 10
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /uwb_follow/person_pose
          Value: true
        - Alpha: 1
          Buffer Length: 1
          Class: rviz_default_plugins/Path
          Color: 255; 60; 60
          Enabled: true
          Line Style: Lines
          Line Width: 0.06
          Name: Person Trail
          Pose Style: None
          Topic:
            Depth: 5
            Durability Policy: Volatile
            Filter size: 10
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /uwb_follow/person_trail
          Value: true
        - Alpha: 1
          Buffer Length: 1
          Class: rviz_default_plugins/Path
          Color: 20; 255; 40
          Enabled: true
          Line Style: Lines
          Line Width: 0.09
          Name: Follow Path
          Pose Style: None
          Topic:
            Depth: 5
            Durability Policy: Transient Local
            Filter size: 10
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /smoothed_global_path
          Value: true
        - Class: rviz_default_plugins/Marker
          Enabled: true
          Marker Topic:
            Depth: 5
            Durability Policy: Volatile
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /pure_pursuit_local_planner/lookahead_point
          Name: Lookahead Point
          Namespaces: {}
          Queue Size: 10
          Value: true
      Enabled: true
      Name: UWB Follow
    - Class: rviz_common/Group
      Displays:
        - Alpha: 0.65
          Class: rviz_default_plugins/Map
          Color Scheme: costmap
          Draw Behind: true
          Enabled: true
          Name: Local Costmap
          Topic:
            Depth: 5
            Durability Policy: Volatile
            Filter size: 10
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /local_costmap/costmap
          Update Topic:
            Depth: 5
            Durability Policy: Volatile
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /local_costmap/costmap_updates
          Use Timestamp: false
          Value: true
        - Alpha: 1
          Buffer Length: 1
          Class: rviz_default_plugins/Path
          Color: 255; 170; 0
          Enabled: true
          Line Style: Lines
          Line Width: 0.1
          Name: AStar Avoidance Path
          Pose Style: None
          Topic:
            Depth: 5
            Durability Policy: Volatile
            Filter size: 10
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /pure_pursuit_local_planner/local_path_astar
          Value: true
        - Alpha: 1
          Buffer Length: 1
          Class: rviz_default_plugins/Path
          Color: 0; 180; 255
          Enabled: true
          Line Style: Lines
          Line Width: 0.06
          Name: Executed Local Trajectory
          Pose Style: None
          Topic:
            Depth: 5
            Durability Policy: Volatile
            Filter size: 10
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /pure_pursuit_local_planner/local_trajectory
          Value: true
        - Class: rviz_default_plugins/MarkerArray
          Enabled: true
          Marker Topic:
            Depth: 5
            Durability Policy: Volatile
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /pure_pursuit_local_planner/astar_markers
          Name: AStar Start and Goal
          Namespaces: {}
          Queue Size: 10
          Value: true
        - Class: rviz_default_plugins/Marker
          Enabled: true
          Marker Topic:
            Depth: 5
            Durability Policy: Volatile
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /pure_pursuit_local_planner/local_goal_marker
          Name: Avoidance Goal
          Namespaces: {}
          Queue Size: 10
          Value: true
        - Class: rviz_default_plugins/Marker
          Enabled: true
          Marker Topic:
            Depth: 5
            Durability Policy: Volatile
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /pure_pursuit_local_planner/front_detection_area
          Name: Front Detection Area
          Namespaces: {}
          Queue Size: 10
          Value: true
        - Class: rviz_default_plugins/Marker
          Enabled: true
          Marker Topic:
            Depth: 5
            Durability Policy: Volatile
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /obstacle_stop/detection_marker
          Name: Emergency Stop Area
          Namespaces: {}
          Queue Size: 10
          Value: true
        - Class: rviz_default_plugins/Marker
          Enabled: true
          Marker Topic:
            Depth: 5
            Durability Policy: Volatile
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /pure_pursuit_local_planner/velocity_arrow
          Name: Velocity Arrow
          Namespaces: {}
          Queue Size: 10
          Value: true
      Enabled: true
      Name: Local Avoidance
  Enabled: true
  Global Options:
    Background Color: 35; 35; 35
    Fixed Frame: odom
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
      Hide Inactive Objects: true
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
      Line color: 128; 128; 0
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 12
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.06
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.01
      Pitch: 1.5708
      Target Frame: <Fixed Frame>
      Value: Orbit (rviz_default_plugins)
      Yaw: 0
    Saved: ~
Window Geometry:
  Displays:
    collapsed: false
  Height: 900
  Hide Left Dock: false
  Hide Right Dock: false
  Width: 1450
  X: 100
  Y: 80
