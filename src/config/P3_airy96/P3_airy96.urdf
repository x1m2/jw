<?xml version="1.0"?>
<!--
  Fixed transforms from P3_airy96.yaml.
  The YAML stores rotations as matrices; the origins below are the equivalent
  roll/pitch/yaw values (radians) used by URDF.
-->
<robot name="p3_airy96">
  <link name="base_link"/>
  <link name="rslidar_front"/>
  <link name="rslidar_rear"/>

  <joint name="base_to_rslidar_front" type="fixed">
    <parent link="base_link"/>
    <child link="rslidar_front"/>
    <origin xyz="0.47 0.0 -0.05"
            rpy="-1.557892 1.481324 -1.553638"/>
  </joint>

  <joint name="base_to_rslidar_rear" type="fixed">
    <parent link="base_link"/>
    <child link="rslidar_rear"/>
    <origin xyz="-0.47 0.0 -0.07"
            rpy="-2.582817 1.554548 0.558965"/>
  </joint>
</robot>
