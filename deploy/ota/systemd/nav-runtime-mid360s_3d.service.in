[Unit]
Description=Navigation Runtime (MID360s 3D / SCAN Planner)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple

# Run permission setup as root, including the map conversion helper.
ExecStartPre=+/usr/bin/chmod 755 "@OTA_ROOT@/slam/pack/content/lidar/livox_ros_driver2_node"
ExecStartPre=+/usr/bin/chmod 755 "@OTA_ROOT@/slam/pack/content/localization/@LOCALIZATION_NODE@"
ExecStartPre=+/usr/bin/chmod 755 "@OTA_ROOT@/slam/pack/content/localization/voxelmaps_saver"
ExecStartPre=+/usr/bin/chmod 755 "@OTA_ROOT@/slam/pack/content/mapping/fastlio_mapping_node"
ExecStartPre=+/usr/bin/chmod 755 "@OTA_ROOT@/slam/pack/content/pgo_sc/pgo_sc_node"
ExecStartPre=+/usr/bin/chmod 755 "@OTA_ROOT@/nav/pack/content/global_path_planner/global_path_planner_node"
ExecStartPre=+/usr/bin/chmod 755 "@OTA_ROOT@/nav/pack/content/obstacle_stop/obstacle_stop_node"
ExecStartPre=+/usr/bin/chmod 755 "@OTA_ROOT@/nav/pack/content/path_smoother/path_smoother_node"
ExecStartPre=+/usr/bin/chmod 755 "@OTA_ROOT@/nav/pack/content/scan_planner/scan_planner_node"
ExecStartPre=+/usr/bin/chmod 755 "@OTA_ROOT@/slam_manager/pack/content/nav_server/nav_server_node"
ExecStartPre=+/usr/bin/chmod 755 "@OTA_ROOT@/slam_manager/pack/content/slam_manager/slam_manager_node"

ExecStartPre=+/usr/bin/mkdir -p "/home/jw/ota/data/slam_data/log/runtime"
# Keep the entire data tree writable by the runtime user, including data itself.
ExecStartPre=+/usr/bin/chown -R @RUN_USER@:@RUN_GROUP@ "/home/jw/ota/data"
ExecStartPre=+/usr/bin/chmod -R u+rwX,g+rwX,o+rX "/home/jw/ota/data"

User=@RUN_USER@
Group=@RUN_GROUP@
Environment="HOME=@RUN_HOME@"
Environment="OTA_ROOT=@OTA_ROOT@"
Environment="LOCALIZATION_ALGORITHM=@LOCALIZATION_ALGORITHM@"
WorkingDirectory=@OTA_ROOT@
ExecStart=/bin/bash "@START_SCRIPT@"

Restart=on-failure
RestartSec=5
# Let the shell handle graceful node shutdown first.
KillMode=mixed
TimeoutStopSec=30
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
